#!/usr/bin/env bash

# game board
W=81
H=31
HALFHEIGHT=$((H / 2))
MAXHEIGHT=$((H - 1))
MAX=$((W * H - 1))
NET=$((W / 2))

# paddle
PADDLE_HEIGHT=6
PADDLE_LEFT_X=0
PADDLE_LEFT_Y=$(((H - PADDLE_HEIGHT) / 2))

PADDLE_RIGHT_X=0
PADDLE_RIGHT_Y=$((PADDLE_LEFT_Y))

BALL_X=5
BALL_Y=20

# delta of ball movement
BX=1
BY=1

clear
tput civis

declare -a grid

render() {
  draw_left_paddle
  draw_right_paddle
  draw_ball
  local r c color
  for ((r = 0; r < H; r++)); do
    for ((c = 0; c < W; c++)); do
      color=${grid[r * W + c]:-0}
      ((c == $NET)) && color=3
      ((r == 0 || r == $MAXHEIGHT)) && color=1
      case "$color" in
      0) printf "%s\x1B[30m" ;;&
      1) printf "%s\x1B[37m" ;;&
      2) printf "%s\x1B[37m" ;;&
      3) printf "%s\x1B[37;40m\u25A0\x1B[0m" ;;
      *) printf "%s\x1B[0m" $'\u2588' ;;
      esac
    done
    printf '\n'
  done
}

draw_left_paddle() {
  for ((i = 0; i < PADDLE_HEIGHT; i++)); do
    ((grid[(PADDLE_LEFT_Y + i) * W] = 1))
  done
}

draw_right_paddle() {
  for ((i = 0; i < PADDLE_HEIGHT; i++)); do
    ((grid[(PADDLE_RIGHT_Y + i) * W + (W - 1)] = 1))
  done
}

left_paddle_up() {
  # remove former paddle
  for ((i = 0; i < PADDLE_HEIGHT; i++)); do
    ((grid[(PADDLE_LEFT_Y + i) * W] = 0))
  done
  # move
  [[ $PADDLE_LEFT_Y -gt 0 ]] && ((PADDLE_LEFT_Y -= 1))
}

left_paddle_down() {
  # remove former paddle
  for ((i = 0; i < PADDLE_HEIGHT; i++)); do
    ((grid[(PADDLE_LEFT_Y + i) * W] = 0))
  done
  # move
  [[ $PADDLE_LEFT_Y -lt $((MAXHEIGHT - PADDLE_HEIGHT)) ]] && ((PADDLE_LEFT_Y += 1))
}

right_paddle_up() {
  # remove former paddle
  for ((i = 0; i < PADDLE_HEIGHT; i++)); do
    ((grid[(PADDLE_RIGHT_Y + i) * W + (W - 1)] = 0))
  done
  # move
  [[ $PADDLE_RIGHT_Y -gt 1 ]] && ((PADDLE_RIGHT_Y -= 1))
}

right_paddle_down() {
  # remove former paddle
  for ((i = 0; i < PADDLE_HEIGHT; i++)); do
    ((grid[(PADDLE_RIGHT_Y + i) * W + (W - 1)] = 0))
  done
  # move
  [[ $PADDLE_RIGHT_Y -lt $((MAXHEIGHT - PADDLE_HEIGHT)) ]] && ((PADDLE_RIGHT_Y += 1))
}

draw_ball() {
  grid[$((BALL_Y * W + BALL_X))]=3
}

move_ball_x() {
  # erase existing ball - x always gets called
  grid[$((BALL_Y * W + BALL_X))]=0

  # draw new ball
  [[ $BALL_X -eq 1 ]] && BX=$((-BX))
  [[ $BALL_X -eq $((W - 2)) ]] && BX=$((-BX))

  BALL_X=$((BALL_X + BX))
}

move_ball_y() {
  # draw new ball
  [[ $BALL_Y -eq 1 ]] && BY=1
  [[ $BALL_Y -eq $((H - 2)) ]] && BY=-1

  BALL_Y=$((BALL_Y + BY))
}

game_loop() {
  render
  local tick_count=0
  while read -r action char; do
    case "$action" in
    tick)
      tick_count=$(((tick_count + 1) % 3))
      move_ball_x
      ((tick_count == 0)) && move_ball_y
      draw_ball
      ;;
    input)
      [[ "$char" == "q" ]] && left_paddle_up
      [[ "$char" == "a" ]] && left_paddle_down
      [[ "$char" == "w" ]] && right_paddle_up
      [[ "$char" == "s" ]] && right_paddle_down
      ;;
    esac
    echo -ne '\x1B[1;1H'
    render
  done
}

input_task() {
  local char
  while read -rsn1 char; do
    echo "input $char"
  done
}

tick_task() {
  while true; do
    sleep 0.5
    echo tick
  done
}

game_dir=$(mktemp -d) || exit 1
game_pipe="$game_dir/events"

cleanup() {
  trap '' INT TERM
  clear

  #Stop background tasks, then wait for them to finish
  [[ -n "$input_pid" ]] && kill "$input_pid" 2>/dev/null
  [[ -n "$tick_pid" ]] && kill "$tick_pid" 2>/dev/null

  [[ -n "$input_pid" ]] && wait "$input_pid" 2>/dev/null
  [[ -n "$input_pid" ]] && wait "$input_pid" 2>/dev/null

  rm -f "$game_pipe"
  rmdir "$game_dir"

  printf '\x1B[0m'
  tput cnorm

}

input_id=
tick_pid=

trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

mkfifo "$game_pipe" || exit 1

input_task </dev/tty >"$game_pipe" &
input_pid=$!

tick_task >$game_pipe &
tick_pid=$!

game_loop <"$game_pipe"
